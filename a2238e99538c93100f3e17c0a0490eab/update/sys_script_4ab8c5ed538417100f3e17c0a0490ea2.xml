        <script><![CDATA[(function executeRule(current, previous) {

    // Auto-populate Email when Requested for changes
    if (current.requested_for.changes()) {
        if (!current.requested_for.nil()) {
            var requestedUser = current.requested_for.getRefRecord();

            if (requestedUser.isValidRecord()) {
                current.email = requestedUser.getValue('email') || '';
            }
        } else {
            current.email = '';
        }
    }

    // Keep Active synchronized with Status
    current.active = (current.status.toString() != 'closed');

})(current, previous);]]></script>
