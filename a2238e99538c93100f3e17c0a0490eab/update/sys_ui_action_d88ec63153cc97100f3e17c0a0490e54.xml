        <script><![CDATA[if (!(gs.getUser().isMemberOf('HR') ||
      gs.getUser().isMemberOf('IT Support'))) {
    gs.addErrorMessage('You are not authorized to approve this case.');
    action.setRedirectURL(current);
} else if (current.getValue('status') != 'pending') {
    gs.addErrorMessage('Only pending cases can be approved.');
    action.setRedirectURL(current);
